# "simulator" runs anywhere; "pigpio" needs a Raspberry Pi with the pigpio daemon libraries.
SENSOR=simulator
PORT=3000
HOST=0.0.0.0
# Protects start/stop in the UI (open the page with #token=...)
# and POST /api/readings (Authorization: Bearer ...). Without it both are open
# outside production and disabled in production.
API_TOKEN=
DB_PATH=data/zisterne.db

# Wiring (BCM numbers)
TRIGGER_PIN=17
ECHO_PIN=27

# Tank and sensor, all in cm
DIAMETER_CM=199.7
MAX_FILL_LEVEL_CM=184.5
# Distance between sensor and the water surface at maximum fill level
SENSOR_OFFSET_CM=27

# Calibration
TEMPERATURE_C=15
TRIGGER_INTERVAL_MS=200
AVERAGE_MEASUREMENTS=10
MEASUREMENT_TIMEOUT_S=30
