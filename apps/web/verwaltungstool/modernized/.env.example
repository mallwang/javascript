# SQLite database file (created on first start)
DB_PATH=data/app.db
# Public base URL used in activation links
APP_URL=http://localhost:3000
# Mail; if SMTP_HOST is empty, mails are printed to the server console
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=SMTP_USER
SMTP_PASSWORD=SMTP_PASSWORD
MAIL_FROM=kontoverwaltung@example.com
