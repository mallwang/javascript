{
  "name": "family-adventskalender",
  "description": "A christmas calendar built with Ionic Framework and Angular",
  "version": "0.0.1",
  "author": "Markus Allwang",
  "license": "MIT",
  "scripts": {
    "build:dev": "ng build --no-progress --prod --source-map && npm run copy:manifest:dev && npm run copy:qrcode:dev",
    "build:prod": "ng build --prod --no-progress",
    "config:env": "node scripts/setup-angular-environment.js",
    "copy:manifest:dev": "ncp ./src/dev.manifest.webmanifest ./www/manifest.webmanifest",
    "copy:qrcode:dev": "ncp ./src/assets/images/dev.qr-code.jpg ./www/assets/images/qr-code.jpg",
    "explore-source-map": "ng build --prod --source-map&&source-map-explorer www/main*.js",
    "lint": "eslint {e2e,src}/**/*.ts",
    "lint:fix": "eslint {e2e,src}/**/*.ts --fix",
    "ng": "ng",
    "start": "npm run config:env&&ng serve",
    "start:dev": "npm run config:env&&ng serve -o",
    "test": "ng test",
    "test:ci": "ng test --watch=false --progress=false --code-coverage",
    "test:e2e": "ng e2e --no-webdriver-update",
    "prettier:check": "prettier --check **/*.{json,js,ts,yml,yaml,md,html,scss}",
    "prettier:format": "prettier --write **/*.{json,js,ts,yml,yaml,md,html,scss}",
    "webdriver:update": "webdriver-manager update --versions.chrome=86.0.4240.0 --gecko false --standalone false"
  },
  "private": true,
  "dependencies": {
    "@angular/common": "10.1.3",
    "@angular/core": "10.1.3",
    "@angular/forms": "10.1.3",
    "@angular/platform-browser": "10.1.3",
    "@angular/platform-browser-dynamic": "10.1.3",
    "@angular/pwa": "0.1001.3",
    "@angular/router": "10.1.3",
    "@angular/service-worker": "10.1.3",
    "@ionic-native/core": "5.28.0",
    "@ionic-native/splash-screen": "5.28.0",
    "@ionic-native/status-bar": "5.28.0",
    "@ionic/angular": "5.3.3",
    "core-js": "3.6.5",
    "dotenv": "8.2.0",
    "ngx-build-plus": "10.1.1",
    "rxjs": "6.6.3",
    "tslib": "2.0.1",
    "zone.js": "0.11.1"
  },
  "devDependencies": {
    "@angular-devkit/architect": "0.1001.3",
    "@angular-devkit/build-angular": "~0.1001.3",
    "@angular-devkit/core": "~10.1.3",
    "@angular-devkit/schematics": "~10.1.3",
    "@angular/cli": "~10.1.3",
    "@angular/compiler": "~10.1.3",
    "@angular/compiler-cli": "~10.1.3",
    "@angular/language-service": "~10.1.3",
    "@commitlint/cli": "11.0.0",
    "@commitlint/config-conventional": "11.0.0",
    "@ionic/angular-toolkit": "2.3.3",
    "@types/jasmine": "3.5.14",
    "@types/jasminewd2": "~2.0.3",
    "@types/node": "14.11.2",
    "@typescript-eslint/eslint-plugin": "4.2.0",
    "@typescript-eslint/parser": "4.2.0",
    "eslint": "7.9.0",
    "eslint-config-google": "0.14.0",
    "eslint-config-prettier": "6.11.0",
    "eslint-plugin-import": "2.22.0",
    "eslint-plugin-prettier": "3.1.4",
    "husky": "4.3.0",
    "jasmine-core": "3.6.0",
    "jasmine-spec-reporter": "6.0.0",
    "karma": "5.2.2",
    "karma-chrome-launcher": "3.1.0",
    "karma-coverage-istanbul-reporter": "3.0.3",
    "karma-jasmine": "4.0.1",
    "karma-jasmine-html-reporter": "1.5.4",
    "ncp": "2.0.0",
    "prettier": "2.1.2",
    "pretty-quick": "3.0.2",
    "protractor": "7.0.0",
    "puppeteer": "5.3.1",
    "source-map-explorer": "2.5.0",
    "ts-node": "9.0.0",
    "typescript": "~4.0.3"
  },
  "husky": {
    "hooks": {
      "pre-commit": "pretty-quick --staged",
      "pre-push": "npm run lint",
      "commit-msg": "commitlint -E HUSKY_GIT_PARAMS"
    }
  },
  "engineStrict": true,
  "engines": {
    "node": ">= 10.14.0",
    "npm": ">= 6.4.1"
  }
}
