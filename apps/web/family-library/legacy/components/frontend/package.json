{
  "name": "frontend",
  "version": "1.0.0",
  "description": "The Family Library frontend",
  "author": "Markus Allwang",
  "homepage": "",
  "license": "MIT",
  "private": true,
  "scripts": {
    "build:dev": "ng build --source-map",
    "build:prod": "ng build --prod",
    "config:env": "node scripts/setup-angular-environment.js",
    "compodoc": "compodoc src -p compodoc.json --theme \"laravel\" --name \"Family Library Frontend\" --silent",
    "lint": "eslint {e2e,src}/**/*.ts",
    "lint:fix": "eslint {e2e,src}/**/*.ts --fix",
    "explore-source-map": "ng build --prod --source-map&&source-map-explorer dist/frontend/main*.js",
    "start": "npm run config:env&&ng serve",
    "start:dev": "npm run config:env&&ng serve -o",
    "start:local": "http-server dist\\frontend -a 127.0.0.1 -p 4200 -o -P http://127.0.0.1:4200?",
    "test": "ng test",
    "test:e2e": "ng e2e"
  },
  "dependencies": {
    "@angular/animations": "9.1.0",
    "@angular/common": "9.1.0",
    "@angular/compiler": "9.1.0",
    "@angular/core": "9.1.0",
    "@angular/forms": "9.1.0",
    "@angular/platform-browser": "9.1.0",
    "@angular/platform-browser-dynamic": "9.1.0",
    "@angular/router": "9.1.0",
    "@clr/angular": "3.1.4",
    "@clr/icons": "3.0.0",
    "@clr/ui": "3.0.0",
    "@ngx-loading-bar/core": "4.2.0",
    "@ngx-loading-bar/http-client": "4.2.0",
    "@webcomponents/webcomponentsjs": "2.0.0",
    "angular-2-local-storage": "3.0.2",
    "dotenv": "8.2.0",
    "jwt-decode": "2.2.0",
    "rxjs": "6.5.4",
    "tslib": "1.11.1",
    "zone.js": "0.10.2"
  },
  "devDependencies": {
    "@angular-devkit/build-angular": "0.901.8",
    "@angular/cli": "9.1.0",
    "@angular/compiler-cli": "9.1.0",
    "@compodoc/compodoc": "1.1.11",
    "@types/jasmine": "3.5.0",
    "@types/jasminewd2": "2.0.3",
    "@types/node": "12.11.1",
    "codelyzer": "5.1.2",
    "eslint": "6.8.0",
    "http-server": "0.12.3",
    "jasmine-core": "3.5.0",
    "jasmine-spec-reporter": "4.2.1",
    "karma": "4.4.1",
    "karma-chrome-launcher": "3.1.0",
    "karma-coverage-istanbul-reporter": "2.1.0",
    "karma-jasmine": "3.0.1",
    "karma-jasmine-html-reporter": "1.4.2",
    "protractor": "5.4.3",
    "source-map-explorer": "2.4.1",
    "ts-node": "8.8.1",
    "typescript": "3.8.3"
  },
  "engineStrict": true,
  "engines": {
    "node": ">= 10.14.0",
    "npm": ">= 6.4.1"
  }
}
